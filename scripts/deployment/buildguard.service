[Unit]
Description=BuildGuard-AI Backend Service
After=network.target
Wants=network-online.target

[Service]
Type=notify
User=root
WorkingDirectory=/var/www/BuildGuard-AI/backend

# Load environment variables from .env file
EnvironmentFile=/var/www/BuildGuard-AI/backend/.env

# Set additional environment variables
Environment="PATH=/var/www/BuildGuard-AI/backend/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Restart policy
Restart=always
RestartSec=5
StartLimitInterval=600
StartLimitBurst=5

# Process management
KillMode=mixed
KillSignal=SIGTERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=buildguard

# Security
PrivateTmp=yes
NoNewPrivileges=true

# Start command
ExecStart=/var/www/BuildGuard-AI/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 4

# Pre-start check
ExecStartPre=/usr/bin/test -f /var/www/BuildGuard-AI/backend/.env

[Install]
WantedBy=multi-user.target
