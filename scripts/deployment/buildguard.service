[Unit]
Description=BuildGuard-AI Backend Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/BuildGuard-AI/backend

# Set up the PATH to use virtualenv
Environment="PATH=/var/www/BuildGuard-AI/backend/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=600
StartLimitBurst=5

# Process management
KillMode=mixed
KillSignal=SIGTERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=buildguard

# Security
PrivateTmp=yes
NoNewPrivileges=true

# Use the startup script which loads .env file
ExecStart=/bin/bash /var/www/BuildGuard-AI/scripts/deployment/start-backend.sh

[Install]
WantedBy=multi-user.target
